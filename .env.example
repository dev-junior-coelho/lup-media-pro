NEXT_PUBLIC_FIREBASE_API_KEY=fictitious-public-config
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-independent-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-independent-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-independent-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=fictitious-app-id
NEXT_PUBLIC_USE_EMULATORS=false
GOOGLE_CLOUD_PROJECT=your-independent-project
# Desenvolvimento com credenciais de usuário Google: projeto de quota do Auth.
GOOGLE_CLOUD_QUOTA_PROJECT=your-independent-project
FIREBASE_STORAGE_BUCKET=your-independent-project.firebasestorage.app
APP_ORIGIN=https://your-verified-domain.example
META_APP_ID=fictitious-app-id
META_APP_SECRET=configure-in-secret-manager
META_API_VERSION=v24.0
TOKEN_ENCRYPTION_KEY=base64-encoded-random-32-byte-key
# GOOGLE_APPLICATION_CREDENTIALS: local path to untracked service-account file, prefer ADC

LEGACY_MIGRATION_OWNER_UID=fictitious-original-owner-uid

# Cloud Functions reserves FIREBASE_ prefix; use this bucket variable there.
LUP_STORAGE_BUCKET=your-independent-project.firebasestorage.app

# Optional: keep the exact callback already registered with Meta when changing the app domain.
# META_REDIRECT_URI=https://your-existing-domain/api/auth/instagram/callback
