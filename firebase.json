{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "lup-media-pro",
      "predeploy": [
        "npm --prefix functions run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "apphosting": {
    "backendId": "lup-media-pro",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "test-results",
      "playwright-report",
      "**/.env*",
      "**/*-debug.log",
      "functions/lib",
      "gha-creds-*.json"
    ]
  }
}
