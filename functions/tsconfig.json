{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*.ts",
    "../lib/server/worker.ts",
    "../lib/server/meta.ts",
    "../lib/server/security.ts",
    "../lib/server/firebase.ts",
    "../lib/shared/schema.ts"
  ]
}
